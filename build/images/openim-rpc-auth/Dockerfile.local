ARG OPENIM_API_IMAGE=registry.meainternal.com/pingmessenger/openim-api:20260930-1
# Pair the forked auth RPC with the forked API; they share the current protocol
# service name and the split MicroK8s configuration embedded in the API image.
FROM golang:1.25-alpine AS build
WORKDIR /src/openim-server
COPY openim-protocol /src/openim-protocol
COPY open-im-server/go.mod open-im-server/go.sum ./
RUN go mod download
COPY open-im-server .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/openim-rpc-auth ./cmd/openim-rpc/openim-rpc-auth

FROM ${OPENIM_API_IMAGE}
COPY --from=build /out/openim-rpc-auth /openim/openim-server/bin/openim-rpc-auth
COPY open-im-server/build/images/openim-rpc-auth/openim-rpc-auth.local.yml /openim/openim-server/config/openim-rpc-auth.yml
ENTRYPOINT ["./bin/openim-rpc-auth"]
